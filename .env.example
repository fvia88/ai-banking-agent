# Docker Compose defaults: real P1 code with an offline deterministic provider.
# Copy to .env locally. Never commit an API key.
USE_MOCK_AGENT=false
USE_MOCK_SECURITY=false
USE_MOCK_SUBSCRIPTIONS=false
AGENT_PROVIDER=mock

# Optional live Groq interpretation. Set AGENT_PROVIDER=groq to enable it.
# The model below matches the code default; choose one available to your key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AGENT_TIMEOUT_SECONDS=20

# Compose supplies its own container DATABASE_URL; do not put a container
# hostname here for local Python runs. See docs/app/deployment.md.
# Local agent settings use os.getenv and must be exported in your shell.
