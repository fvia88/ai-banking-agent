# One free web service: built frontend + Python API. No secrets enter the image.
FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci --legacy-peer-deps
COPY frontend/ ./
RUN npm run build

FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend:/app \
    BANKLY_FRONTEND_DIR=/app/static
WORKDIR /app
COPY backend/requirements.txt /tmp/requirements/backend.txt
COPY agent/requirements.txt /tmp/requirements/agent.txt
RUN python -m pip install --no-cache-dir --timeout 120 --retries 10 \
    -r /tmp/requirements/backend.txt -r /tmp/requirements/agent.txt
COPY backend/ /app/backend/
COPY contracts/ /app/contracts/
COPY agent/ /app/agent/
COPY finance/ /app/finance/
COPY security/ /app/security/
COPY subscriptions/ /app/subscriptions/
COPY fixtures/ /app/fixtures/
COPY infra/shared_app.py infra/start_shared.py /app/infra/
COPY --from=frontend /build/dist /app/static
COPY infra/test_shared_app.py /tmp/shared-tests/test_shared_app.py
RUN python -c "import app.main; from pathlib import Path; assert Path('/app/static/index.html').is_file()"
RUN python -m pytest -p no:cacheprovider /tmp/shared-tests/test_shared_app.py -q
EXPOSE 10000
CMD ["python", "infra/start_shared.py"]
