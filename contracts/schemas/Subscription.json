{
  "$defs": {
    "Cadence": {
      "enum": [
        "weekly",
        "monthly",
        "annual",
        "unknown"
      ],
      "title": "Cadence",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "subscription_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Subscription Id",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "merchant": {
      "title": "Merchant",
      "type": "string"
    },
    "estimated_amount": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,17}0*$)\\d{0,14}\\.\\d{0,2}0*$)",
          "type": "string"
        }
      ],
      "title": "Estimated Amount"
    },
    "cadence": {
      "$ref": "#/$defs/Cadence"
    },
    "status": {
      "enum": [
        "active",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "cancellation_supported": {
      "title": "Cancellation Supported",
      "type": "boolean"
    }
  },
  "required": [
    "subscription_id",
    "user_id",
    "merchant",
    "estimated_amount",
    "cadence",
    "status",
    "cancellation_supported"
  ],
  "title": "Subscription",
  "type": "object"
}