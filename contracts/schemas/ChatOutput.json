          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "tool",
        "arguments"
      ],
      "title": "ActionProposal",
      "type": "object"
    },
    "ActionStatus": {
      "enum": [
        "PROPOSED",
        "PENDING_CONFIRMATION",
        "PENDING_MFA",
        "COMPLETED",
        "REJECTED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "ActionStatus",
      "type": "string"
    },
    "ToolName": {
      "enum": [
        "get_balance",
        "analyze_spending",
        "list_subscriptions",
        "request_transfer",
        "request_subscription_cancel"
