      "title": "ToolName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conversation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Conversation Id",
      "type": "string"
    },
    "reply": {
      "title": "Reply",
      "type": "string"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/ActionProposal"
      },
      "title": "Actions",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ActionStatus"
    }
  },
  "required": [
    "conversation_id",
    "reply",
    "status"
  ],
  "title": "ChatOutput",
  "type": "object"
}