{
  "$defs": {
    "ActionProposal": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Proposal Id",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ToolName"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "rationale": {
