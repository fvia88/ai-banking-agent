{
  "$defs": {
    "Cadence": {
      "enum": [
        "weekly",
        "monthly",
        "annual",
        "unknown"
      ],
      "title": "Cadence",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "subscription_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Subscription Id",
      "type": "string"
    },
    "merchant": {
      "title": "Merchant",
      "type": "string"
    },
    "estimated_amount": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,17}0*$)\\d{0,14}\\.\\d{0,2}0*$)",
          "type": "string"
        }
      ],
      "title": "Estimated Amount"
    },
    "cadence": {
      "$ref": "#/$defs/Cadence"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence_transaction_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Transaction Ids",
      "type": "array"
    },
    "cancellation_supported": {
      "title": "Cancellation Supported",
      "type": "boolean"
    }
  },
  "required": [
    "subscription_id",
    "merchant",
    "estimated_amount",
    "cadence",
    "confidence",
    "evidence_transaction_ids",
    "cancellation_supported"
  ],
  "title": "SubscriptionCandidate",
  "type": "object"
}