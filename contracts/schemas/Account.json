{
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Account Id",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "currency": {
      "const": "CNY",
      "default": "CNY",
      "title": "Currency",
      "type": "string"
    },
    "balance": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,17}0*$)\\d{0,14}\\.\\d{0,2}0*$)",
          "type": "string"
        }
      ],
      "title": "Balance"
    },
    "locked": {
      "default": false,
      "title": "Locked",
      "type": "boolean"
    }
  },
  "required": [
    "account_id",
    "user_id",
    "balance"
  ],
  "title": "Account",
  "type": "object"
}