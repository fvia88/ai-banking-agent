{
  "$defs": {
    "Direction": {
      "enum": [
        "debit",
        "credit"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Transaction": {
      "additionalProperties": false,
      "properties": {
        "transaction_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Transaction Id",
          "type": "string"
        },
        "account_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,17}0*$)\\d{0,14}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "title": "Amount"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "merchant": {
          "title": "Merchant",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "transaction_id",
        "account_id",
        "timestamp",
        "amount",
        "direction",
        "merchant",
        "category"
      ],
      "title": "Transaction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "transactions": {
      "items": {
        "$ref": "#/$defs/Transaction"
      },
      "title": "Transactions",
      "type": "array"
    }
  },
  "required": [
    "transactions"
  ],
  "title": "TransactionsResponse",
  "type": "object"
}